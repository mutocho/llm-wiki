# Obsidian vault and source paths (use absolute paths on Windows)
OBSIDIAN_VAULT_PATH=C:/Users/<username>/llm-wiki/second-brain
OBSIDIAN_SOURCES_DIR=C:/Users/<username>/llm-wiki
CLAUDE_HISTORY_PATH=C:/Users/<username>/.claude
CODEX_HISTORY_PATH=C:/Users/<username>/.codex

# Warn when a wiki operation is expected to exceed this token count
WIKI_TOKEN_WARN_THRESHOLD=20000
